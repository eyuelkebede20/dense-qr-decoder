{
  "name": "dense-qr-decoder",
  "version": "1.0.5",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean --no-external @undecaf/barcode-detector-polyfill @undecaf/zbar-wasm",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@undecaf/barcode-detector-polyfill": "^0.9.23",
    "@undecaf/zbar-wasm": "^0.11.0"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  }
}
